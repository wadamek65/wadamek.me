---
import AudioButton from '../components/AudioButton.astro';
import Link from '../components/Link.astro';
import Newsletter from '../components/Newsletter.astro';
import PageSection from '../components/PageSection.astro';
import PageSectionTitle from '../components/PageSectionTitle.astro';
import PageTitle from '../components/PageTitle.astro';
import ProfilePicture from '../components/ProfilePicture.astro';
import Layout from '../layouts/Layout.astro';
import wojciechPronunciation from '../media/pl_wojciech.mp3';
import wojtekPronunciation from '../media/pl_wojtek.mp3';
---

<Layout
	title="Wojciech Adamek – Software Architect, Tech Lead, and Consultant"
	description="Explore the portfolio of Wojciech Adamek, a software architect with over 10 years of experience in web development, specializing in the startup space."
>
	<PageTitle>home</PageTitle>
	<PageSection>
		<div class="mb-8 flex justify-center">
			<ProfilePicture />
		</div>
		<div class="space-y-4">
		<p>
			Hi, I'm Wojciech <i>(Voy-chekh)</i><AudioButton
				audioSrc={wojciechPronunciation}
				altText="Play Wojciech Pronunciation"
			/>. You can also call me Wojtek<AudioButton
				audioSrc={wojtekPronunciation}
				altText="Play Wojtek Pronunciation"
			/>. I'm a software architect with over 10 years of experience in web development. I've worked/consulted for 10+ startups.
		</p>
		<p>
			I'm currently working on my own projects and offering consultation and development services.
		</p>
		<ul class="space-y-2">
			<li class="flex items-start space-x-3">
				<span class="mt-0.5 text-emerald-500">→</span>
				<span><span class="font-medium">Starting out as an entrepreneur?</span> I offer architecture design and technical guidance for your product ideas.</span>
			</li>
			<li class="flex items-start space-x-3">
				<span class="mt-0.5 text-emerald-500">→</span>
				<span><span class="font-medium">Startup struggling to move forward?</span> I provide code architecture and scalability audits.</span>
			</li>
			<li class="flex items-start space-x-3">
				<span class="mt-0.5 text-emerald-500">→</span>
				<span><span class="font-medium">Know exactly what you need?</span> I offer custom development (MVPs, e-commerce, static websites, existing apps).</span>
			</li>
		</ul>
		<p>
			Send me a message to consult with me for free!
		</p>
		</div>
	</PageSection>
	<PageSection>
		<PageSectionTitle>socials</PageSectionTitle>
		<div class="mb-4 flex flex-wrap justify-center gap-x-6 gap-y-4 sm:justify-start sm:gap-x-3">
			<Link target="_blank" href="https://github.com/wadamek65">github</Link>|
			<Link target="_blank" href="https://bsky.app/profile/wadamek.me">bluesky</Link>|
			<Link target="_blank" href="https://reddit.com/u/wadamek65">reddit</Link>|
			<Link target="_blank" href="https://www.linkedin.com/in/wadamek65/">linkedin</Link>|
			<Link target="_blank" href="https://soundcloud.com/voy-347736249">soundcloud</Link>|
			<span>wadamek@wadamek.me</span>
		</div>
		<div class="text-xs">
			If someone knows how to get the AI to get the colors of my parrot right please let me know!
		</div>
	</PageSection>
	<PageSection>
		<PageSectionTitle>mailing list</PageSectionTitle>
		<Newsletter>
			<div class="mb-8">
				<p>
					If you'd like to follow my work, hear my insights and occasionally receive a parrot picture, join my mailing list!
				</p>
			</div>
		</Newsletter>
	</PageSection>
</Layout>
